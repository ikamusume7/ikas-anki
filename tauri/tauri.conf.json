{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Anki",
    "version": "0.1.0",
    "identifier": "net.ankiweb.anki",
    "build": {
        "frontendDist": "./web"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.ico", "icons/icon.png"],
        "fileAssociations": [
            {
                "ext": ["apkg"],
                "name": "Anki Deck Package",
                "description": "Anki deck package",
                "mimeType": "application/x-apkg",
                "role": "Editor"
            },
            {
                "ext": ["colpkg"],
                "name": "Anki Collection Package",
                "description": "Anki collection package",
                "mimeType": "application/x-colpkg",
                "role": "Editor"
            },
            {
                "ext": ["ankiaddon"],
                "name": "Anki Add-on Package",
                "description": "Anki add-on package",
                "mimeType": "application/x-ankiaddon",
                "role": "Editor"
            }
        ],
        "resources": {
            "../qt/_aqt/data/web/": "web/",
            "../out/sveltekit/": "sveltekit/"
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    }
}
