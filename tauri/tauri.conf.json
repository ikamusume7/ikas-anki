{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Anki",
    "version": "0.1.0",
    "identifier": "net.ankiweb.anki",
    "build": {
        "frontendDist": "./web"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.ico"],
        "resources": {
            "../qt/_aqt/data/web/": "web/",
            "../out/sveltekit/": "sveltekit/"
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    }
}
